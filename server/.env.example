# Backend environment variables
# Copy this file to `.env` and fill in your values.

PORT=5000

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Where contact form emails should be delivered
CONTACT_TO_EMAIL=subhajitmahapatra7710@gmail.com

# --- Production (Render free plan) ---------------------------------
# Render's free plan BLOCKS outbound SMTP (ports 25/465/587), so Gmail SMTP
# cannot work there. Use an HTTPS email API instead (first one set wins):
#
# Resend: sign up at resend.com with the SAME email as CONTACT_TO_EMAIL,
# create an API key, and paste it here. No domain needed for this use.
RESEND_API_KEY=
# Optional (only after verifying your own domain in Resend):
# MAIL_FROM=Portfolio <contact@yourdomain.com>
#
# Brevo (alternative): verify a sender email in Brevo, create an API key.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=subhajitmahapatra7710@gmail.com

# --- Local development (SMTP) --------------------------------------
# Gmail SMTP works locally; used only if no API key above is set.
# 1) Enable 2-Step Verification on Google Account
# 2) Create an App Password: Google Account → Security → App passwords
# 3) Paste the 16-character app password into SMTP_PASS (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=subhajitmahapatra7710@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Optional absolute path for SQLite file
# DB_PATH=
